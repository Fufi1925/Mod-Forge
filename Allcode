  box-shadow:0 4px 14px rgba(239,68,68,.4)}

/* STATS */
.stats-wrap{position:relative;z-index:1;animation:fadeUp .7s .4s ease both}
.stats-grid{display:flex;justify-content:center;gap:clamp(24px,7vw,80px);flex-wrap:wrap;
  padding:32px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  margin:40px 0}
.stat-item{text-align:center}
.stat-num{font-size:clamp(2rem,5vw,3rem);font-weight:900;line-height:1.1;
  background:linear-gradient(135deg,#fff,var(--p));-webkit-background-clip:text;
  -webkit-text-fill-color:transparent}
.stat-lbl{font-size:.75rem;color:var(--muted);margin-top:4px;font-weight:500}

/* SECTIONS */
.section{padding:clamp(60px,10vw,100px) 16px}
.section-alt{background:rgba(255,255,255,.018)}
.sec-head{text-align:center;margin-bottom:clamp(28px,5vw,50px)}
.sec-head h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;margin-bottom:10px}
.sec-head p{color:var(--muted);font-size:1rem;max-width:600px;margin:0 auto}
.sec-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 14px;
  border-radius:999px;background:rgba(91,110,255,.1);border:1px solid rgba(91,110,255,.2);
  color:var(--p);font-size:.78rem;margin-bottom:12px}

/* FEATURE CARDS */
.feat-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
.feat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  padding:22px;transition:all var(--t);cursor:default;position:relative;overflow:hidden}
.feat-card::before{content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(91,110,255,0),rgba(91,110,255,.05));
  opacity:0;transition:opacity var(--t)}
.feat-card:hover{transform:translateY(-6px);border-color:rgba(91,110,255,.4);
  box-shadow:0 16px 40px rgba(91,110,255,.18)}
.feat-card:hover::before{opacity:1}
.feat-icon{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;
  justify-content:center;margin-bottom:14px;font-size:1.3rem;transition:transform var(--t)}
.feat-card:hover .feat-icon{transform:scale(1.15) rotate(-5deg)}
.feat-card h3{font-size:.95rem;font-weight:700;margin-bottom:6px}
.feat-card p{font-size:.78rem;color:var(--muted);line-height:1.6}

/* DEMO WINDOW */
.demo-window{background:var(--card);border:1px solid var(--border);border-radius:16px;
  overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.5);
  animation:scaleIn .6s ease both}
.demo-titlebar{display:flex;align-items:center;gap:8px;padding:12px 16px;
  border-bottom:1px solid var(--border);background:rgba(0,0,0,.2)}
.demo-dots{display:flex;gap:6px}
.demo-dots span{width:12px;height:12px;border-radius:50%}
.demo-url{flex:1;background:rgba(255,255,255,.05);border-radius:6px;padding:4px 12px;
  font-size:.73rem;color:var(--muted);text-align:center}
.demo-inner{display:flex;height:340px}
.demo-sidebar{width:160px;border-right:1px solid var(--border);padding:12px 8px;
  background:rgba(0,0,0,.15);flex-shrink:0}
.demo-nav-item{display:flex;align-items:center;gap:7px;padding:7px 9px;border-radius:7px;
  font-size:.73rem;color:var(--muted);margin-bottom:2px;cursor:default;transition:all .15s}
.demo-nav-item.on{background:rgba(91,110,255,.15);color:var(--p);font-weight:600;
  border-left:2px solid var(--p)}
.demo-content{flex:1;padding:14px;overflow:hidden}
.demo-kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.demo-kpi{background:rgba(255,255,255,.04);border-radius:8px;padding:10px;text-align:center}
.demo-kpi .v{font-size:1.4rem;font-weight:800}
.demo-kpi .l{font-size:.65rem;color:var(--muted)}
.demo-list{background:rgba(0,0,0,.15);border-radius:8px;overflow:hidden}
.demo-list-row{display:flex;align-items:center;gap:8px;padding:6px 10px;
  border-bottom:1px solid rgba(255,255,255,.04);font-size:.7rem}
.demo-list-row:last-child{border-bottom:none}
.demo-tag{display:inline-block;padding:1px 6px;border-radius:4px;font-size:.6rem;font-weight:700}

/* LOG GRID */
.log-grid{display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
.log-chip{background:var(--card);border:1px solid var(--border);border-radius:8px;
  padding:8px 12px;font-size:.78rem;text-align:center;transition:all var(--t)}
.log-chip:hover{border-color:rgba(91,110,255,.4);color:var(--p)}
.log-chip .hash{color:var(--p);margin-right:3px}

/* CTA BOX */
.cta-box{background:var(--card);border:1px solid var(--border);border-radius:20px;
  padding:clamp(36px,6vw,64px);text-align:center;position:relative;overflow:hidden;
  max-width:750px;margin:0 auto}
.cta-box::before{content:'';position:absolute;width:400px;height:400px;border-radius:50%;
  background:rgba(91,110,255,.12);top:-150px;right:-120px;filter:blur(80px)}
.cta-box::after{content:'';position:absolute;width:300px;height:300px;border-radius:50%;
  background:rgba(180,127,255,.08);bottom:-100px;left:-80px;filter:blur(60px)}
.cta-box h2{font-size:clamp(1.6rem,3.5vw,2.2rem);font-weight:800;margin-bottom:14px;position:relative}
.cta-box p{color:var(--muted);margin-bottom:28px;position:relative}

/* CHANGELOG */
.timeline{position:relative;max-width:760px;margin:0 auto}
.timeline::before{content:'';position:absolute;left:24px;top:0;bottom:0;
  width:2px;background:linear-gradient(to bottom,var(--p),transparent)}
.tl-item{display:flex;gap:20px;margin-bottom:36px;position:relative}
.tl-dot{width:50px;height:50px;border-radius:50%;background:var(--card);
  border:2px solid var(--p);display:flex;align-items:center;justify-content:center;
  font-size:1rem;flex-shrink:0;box-shadow:0 0 0 4px rgba(91,110,255,.15);z-index:1}
.tl-body{flex:1;background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px}
.tl-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.tl-ver{font-weight:800;font-size:1rem}
.tl-date{font-size:.75rem;color:var(--muted)}
.tl-badge{font-size:.65rem;padding:2px 8px;border-radius:999px;font-weight:700}
.tl-badge.major{background:rgba(91,110,255,.2);color:var(--p)}
.tl-badge.fix{background:rgba(34,197,94,.15);color:#86efac}
.tl-badge.new{background:rgba(234,179,8,.15);color:#fcd34d}
.tl-changes{list-style:none}
.tl-changes li{display:flex;align-items:flex-start;gap:8px;font-size:.82rem;
  color:var(--muted);margin-bottom:5px;line-height:1.55}
.tl-changes li::before{content:'→';color:var(--p);flex-shrink:0;margin-top:1px}

/* FOOTER */
.footer{padding:clamp(36px,6vw,56px) 16px;border-top:1px solid var(--border);
  background:rgba(0,0,0,.2)}
.footer-inner{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:clamp(20px,5vw,48px);max-width:900px;margin:0 auto 28px}
.footer h4{font-size:.78rem;font-weight:700;color:var(--p);margin-bottom:12px;
  text-transform:uppercase;letter-spacing:.05em}
.footer a{display:block;color:var(--muted);font-size:.78rem;margin-bottom:6px;
  transition:color .2s}
.footer a:hover{color:var(--fg)}
.footer-bottom{text-align:center;color:var(--muted);font-size:.72rem;
  padding-top:20px;border-top:1px solid var(--border)}

/* STATUS */
.status-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:24px 0}
.status-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  padding:22px;text-align:center}
.status-card h4{font-size:.75rem;color:var(--muted);margin-bottom:10px;font-weight:500}
.metric-big{font-size:2.5rem;font-weight:900;background:linear-gradient(135deg,#fff,var(--p));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent}
.dot-on{width:9px;height:9px;border-radius:50%;background:var(--ok);
  box-shadow:0 0 10px rgba(34,197,94,.6);display:inline-block;margin-right:6px;
  animation:pulse 2s ease-in-out infinite}

/* LEGAL */
.legal-wrap{max-width:860px;margin:40px auto;padding:20px}
.legal-wrap h1{font-size:clamp(1.7rem,4vw,2rem);font-weight:800;margin-bottom:6px}
.legal-wrap .date{color:var(--muted);margin-bottom:28px;font-size:.85rem}
.legal-wrap h2{font-size:1.1rem;color:var(--p);margin:24px 0 10px;font-weight:700}
.legal-wrap p,.legal-wrap li{color:var(--muted);font-size:.88rem;line-height:1.75;margin-bottom:8px}
.legal-wrap ul{margin-left:20px;margin-bottom:14px}
.legal-wrap strong{color:var(--fg)}
details{background:var(--card);border:1px solid var(--border);border-radius:var(--r);margin-bottom:10px}
summary{padding:13px 18px;font-weight:600;cursor:pointer;list-style:none;font-size:.9rem;
  display:flex;justify-content:space-between;align-items:center;
  user-select:none;color:var(--fg)}
summary::-webkit-details-marker{display:none}
summary::after{content:'›';color:var(--p);font-size:1.1rem;transition:transform .2s}
details[open] summary::after{transform:rotate(90deg)}
.detail-body{padding:0 18px 16px;color:var(--muted);font-size:.84rem;line-height:1.7}

/* ─── ADMIN DASHBOARD ─── */
.dash-wrap{display:flex;height:100vh;overflow:hidden;background:var(--bg)}
.sidebar{width:240px;flex-shrink:0;background:var(--sidebar);
  border-right:1px solid var(--sb-border);display:flex;flex-direction:column}
.sb-top{padding:16px;border-bottom:1px solid var(--sb-border)}
.sb-logo{display:flex;align-items:center;gap:8px;margin-bottom:14px}
.sb-logo .ico{width:28px;height:28px;border-radius:7px;
  background:linear-gradient(135deg,var(--p),var(--p2));display:flex;align-items:center;justify-content:center}
.sb-logo span{font-weight:800;font-size:1rem}
.sb-guild-card{background:rgba(255,255,255,.04);border:1px solid var(--sb-border);
  border-radius:8px;padding:9px 10px;display:flex;align-items:center;gap:8px}
.sb-av{width:26px;height:26px;border-radius:7px;background:rgba(91,110,255,.2);
  display:flex;align-items:center;justify-content:center;font-weight:700;
  font-size:.75rem;color:var(--p);flex-shrink:0}
.sb-guild-name{font-size:.8rem;font-weight:500}
.sb-guild-sub{font-size:.65rem;color:var(--muted)}
.sb-nav{flex:1;padding:10px 8px;overflow-y:auto}
.sb-sec-label{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
  color:var(--muted);padding:8px 10px 3px}
.sb-link{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;
  font-size:.82rem;color:var(--muted);transition:all var(--t)}
.sb-link:hover{background:rgba(255,255,255,.05);color:var(--fg)}
.sb-link.act{background:rgba(91,110,255,.15);color:var(--p);font-weight:600;
  border-left:2px solid var(--p);padding-left:8px}
.sb-foot{padding:10px;border-top:1px solid var(--sb-border)}
.sb-user-row{display:flex;align-items:center;gap:8px;padding:8px 10px;
  border-radius:8px;cursor:pointer;transition:background var(--t)}
.sb-user-row:hover{background:rgba(255,255,255,.04)}
.sb-user-row .uname{font-size:.8rem;font-weight:500;flex:1}
.sb-user-row .urole{font-size:.65rem;color:var(--muted)}
.main-area{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{padding:13px 22px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.topbar h1{font-size:1.15rem;font-weight:700}
.topbar p{font-size:.75rem;color:var(--muted)}
.content-scroll{flex:1;overflow-y:auto;padding:22px}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:14px;margin-bottom:22px}
.kpi-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:18px}
.kpi-card .ico{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;
  justify-content:center;font-size:1rem;margin-bottom:12px}
.kpi-card .num{font-size:2rem;font-weight:900;line-height:1}
.kpi-card .lbl{font-size:.73rem;color:var(--muted);margin-top:3px}
.kpi-card .chg{font-size:.68rem;color:var(--ok);margin-top:3px}
.data-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}
@media(max-width:960px){.data-2{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.panel-head{display:flex;align-items:center;gap:8px;padding:13px 16px;
  border-bottom:1px solid var(--border);font-size:.84rem;font-weight:600}
.panel-body{max-height:360px;overflow-y:auto}
.ev-row{padding:8px 14px;border-bottom:1px solid rgba(255,255,255,.035);
  display:flex;align-items:center;gap:8px;font-size:.77rem}
.ev-row:last-child{border-bottom:none}
.ev-kind{font-size:.6rem;padding:2px 6px;border-radius:4px;background:rgba(91,110,255,.12);
  color:var(--p);font-weight:700;text-transform:uppercase;white-space:nowrap}
.ev-ts{font-size:.65rem;color:var(--muted);margin-left:auto;white-space:nowrap}
.tbl-wrap{background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  overflow:hidden;margin-bottom:22px}
.tbl-head{padding:13px 16px;border-bottom:1px solid var(--border);font-size:.84rem;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:.78rem}
th{padding:9px 14px;border-bottom:1px solid var(--border);text-align:left;
  font-size:.65rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}
td{padding:9px 14px;border-bottom:1px solid rgba(255,255,255,.035);vertical-align:middle}
tr:last-child td{border-bottom:none}
.tag{display:inline-block;padding:2px 7px;border-radius:5px;font-size:.67rem;font-weight:600}
.tag-ok{background:rgba(34,197,94,.12);color:#86efac}
.tag-warn{background:rgba(234,179,8,.12);color:#fcd34d}
.tag-err{background:rgba(239,68,68,.12);color:#fca5a5}
.tag-info{background:rgba(91,110,255,.12);color:var(--p)}
.tag-def{background:rgba(255,255,255,.06);color:var(--muted)}

/* USER DASHBOARD */
.dash-main{max-width:960px;margin:0 auto;padding:28px 16px}
.dash-sec-head{margin-bottom:24px}
.dash-sec-head h1{font-size:1.5rem;font-weight:800;margin-bottom:4px}
.dash-sec-head p{font-size:.85rem;color:var(--muted)}
.module-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-bottom:28px}
.module-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px;
  transition:all var(--t)}
.module-card:hover{border-color:rgba(91,110,255,.3)}
.module-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.module-card-title{display:flex;align-items:center;gap:10px;font-weight:700;font-size:.95rem}
.module-card-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;
  justify-content:center;font-size:1.1rem}
.module-card-desc{font-size:.78rem;color:var(--muted);margin-bottom:14px;line-height:1.55}
.module-card-meta{display:flex;gap:8px;flex-wrap:wrap}
.meta-chip{font-size:.67rem;padding:2px 8px;border-radius:999px;
  background:rgba(255,255,255,.05);color:var(--muted)}
/* Toggle switch */
.toggle{position:relative;width:42px;height:24px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0;position:absolute}
.toggle-track{position:absolute;inset:0;border-radius:12px;background:rgba(255,255,255,.1);
  cursor:pointer;transition:background var(--t)}
.toggle input:checked+.toggle-track{background:var(--ok)}
.toggle-thumb{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;
  background:#fff;pointer-events:none;transition:transform var(--t);
  box-shadow:0 1px 4px rgba(0,0,0,.3)}
.toggle input:checked~.toggle-thumb{transform:translateX(18px)}

/* SERVER SELECT */
.srv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.srv-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px;
  display:flex;align-items:center;gap:14px;transition:all var(--t)}
.srv-card:hover{border-color:rgba(91,110,255,.35);transform:translateY(-3px);
  box-shadow:0 10px 28px rgba(0,0,0,.4)}
.srv-av{width:48px;height:48px;border-radius:12px;background:rgba(91,110,255,.2);
  display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;
  color:var(--p);flex-shrink:0;overflow:hidden}
.srv-av img{width:100%;height:100%;object-fit:cover;border-radius:12px}
.srv-name{font-weight:700;font-size:.95rem}
.srv-meta{font-size:.72rem;color:var(--muted);margin-top:2px}
.srv-btn{margin-top:14px;display:block;text-align:center;padding:9px;border-radius:8px;
  background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;font-size:.82rem;font-weight:600;
  transition:all var(--t)}
.srv-btn:hover{box-shadow:0 4px 14px rgba(91,110,255,.4);transform:translateY(-1px)}

/* EMBED BUILDER */
.embed-builder{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:800px){.embed-builder{grid-template-columns:1fr}}
.embed-form{display:flex;flex-direction:column;gap:14px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-label{font-size:.78rem;font-weight:600;color:var(--muted);
  text-transform:uppercase;letter-spacing:.04em}
.form-input,.form-textarea,.form-select{
  background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:9px;
  color:var(--fg);font-size:.9rem;padding:10px 14px;transition:.2s;outline:none;
  font-family:inherit;width:100%}
.form-input:focus,.form-textarea:focus,.form-select:focus{
  border-color:var(--p);background:rgba(91,110,255,.05)}
.form-textarea{resize:vertical;min-height:100px}
.form-select option{background:var(--card)}
.color-row{display:flex;align-items:center;gap:10px}
.color-preview{width:34px;height:34px;border-radius:8px;border:2px solid var(--border);
  flex-shrink:0;cursor:pointer}
/* Discord embed preview */
.discord-preview{background:#36393f;border-radius:12px;padding:16px;
  font-family:'Whitney','Helvetica Neue',Helvetica,Arial,sans-serif}
.discord-msg{display:flex;gap:12px}
.discord-avatar{width:40px;height:40px;border-radius:50%;background:var(--p);
  display:flex;align-items:center;justify-content:center;font-weight:700;
  font-size:.9rem;color:#fff;flex-shrink:0}
.discord-content{flex:1}
.discord-username{font-weight:700;font-size:.95rem;color:#fff}
.discord-embed{border-left:4px solid var(--p);background:#2f3136;border-radius:4px;
  padding:12px 16px;margin-top:6px;max-width:440px}
.discord-embed-title{font-weight:700;font-size:.95rem;color:#fff;margin-bottom:6px}
.discord-embed-desc{font-size:.85rem;color:#dcddde;line-height:1.55;margin-bottom:8px;white-space:pre-wrap}
.discord-embed-img{width:100%;border-radius:6px;margin-top:8px;max-height:200px;object-fit:cover}
.discord-embed-thumb{float:right;width:70px;height:70px;border-radius:4px;object-fit:cover;margin-left:12px}
.discord-embed-footer{font-size:.72rem;color:#72767d;margin-top:8px}
.vars-hint{font-size:.73rem;color:var(--muted);padding:8px 12px;border-radius:8px;
  background:rgba(255,255,255,.03);border:1px solid var(--border)}
.vars-hint code{color:var(--p);font-family:monospace;font-size:.8rem}

/* SETTINGS FORM */
.settings-panel{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:22px;margin-bottom:18px}
.settings-panel h3{font-size:1rem;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;
  border-bottom:1px solid rgba(255,255,255,.04)}
.settings-row:last-child{border-bottom:none}
.settings-row-label{font-size:.85rem;font-weight:500}
.settings-row-desc{font-size:.72rem;color:var(--muted);margin-top:2px}
.save-btn{padding:10px 28px;border-radius:9px;background:linear-gradient(135deg,var(--p),var(--p2));
  color:#fff;font-weight:600;font-size:.9rem;cursor:pointer;border:none;transition:all var(--t);
  margin-top:18px}
.save-btn:hover{box-shadow:0 4px 16px rgba(91,110,255,.5);transform:translateY(-2px)}
.save-btn.saving{opacity:.7;cursor:not-allowed}
