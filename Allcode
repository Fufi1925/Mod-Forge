    pun_opts="".join(f'<option value="{p}" {"selected" if punishment==p else ""}>{p}</option>'
                     for p in VALID_PUNISHMENTS)
    extra=""
    if section=="antispam":
        extra=f"""<div class="settings-row"><div><div class="settings-row-label">Max. Nachrichten</div>
