# ══════════════════════════════════════════════════
#  ModForge Bot – Environment Variables
#  Kopiere diese Datei als .env (NUR lokal, nie in Git!)
#  In Railway: Variables → Add Variable
# ══════════════════════════════════════════════════

# ── Discord Bot ──────────────────────────────────
# Holen unter: https://discord.com/developers/applications
# → Deine App → Bot → Token (Reset Token)
DISCORD_TOKEN=dein_bot_token_hier

# Application ID (auf der General Information Seite)
CLIENT_ID=deine_application_id_hier

# Client Secret (OAuth2 → General → Client Secret)
# Wird benötigt damit das Dashboard funktioniert
CLIENT_SECRET=dein_client_secret_hier

# ── Datenbank ────────────────────────────────────
# Railway stellt das automatisch bereit wenn du
# einen PostgreSQL Service hinzufügst!
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/modforge

# ── Dashboard ────────────────────────────────────
# Öffentliche URL deines Dashboards (ohne Slash am Ende)
# Beispiel: https://modforge-dashboard.up.railway.app
DASHBOARD_URL=https://dein-dashboard.up.railway.app

# ── Sicherheit ───────────────────────────────────
# Generiere mit: openssl rand -hex 32
SESSION_SECRET=generiere_einen_langen_zufaelligen_string_hier

# ── Bot Owner ─────────────────────────────────────
# Deine Discord User-ID (Rechtsklick auf dich → ID kopieren)
BOT_OWNER_ID=deine_discord_user_id

# ── Port (wird von Railway automatisch gesetzt) ──
# PORT=3001
